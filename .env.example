# Agentic Universe: Pipeline Configuration (Assignment A)
#
# Secret key for HMAC blind indexing and AES-256-GCM encryption.
# Must be a 32-byte (64 hex characters) cryptographic key.
# Generate a new random key with:
# python -c "import secrets; print(secrets.token_hex(32))"
PII_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database storage path (defaults to au_ledger.db)
DATABASE_PATH=au_ledger.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Set to true to enforce that PII_SECRET_KEY is explicitly configured
STRICT_SECURITY=false

